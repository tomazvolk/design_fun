// Bledara data model. Every tenant record carries orgId; see docs/DATA-MODEL.md for the map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────── Auth (managed by Better Auth) ─────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
  auditLogs   AuditLog[]
  employees   Employee[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────────────────── Tenant ─────────────────────────

enum Role {
  ADMIN
  FINANCE
  IT
  OWNER
  EMPLOYEE
}

model Organisation {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  currency     String   @default("EUR")
  /// Per-organisation address that forwarded invoices land in (mocked inbox).
  inboxAddress String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       Membership[]
  teams             Team[]
  employees         Employee[]
  vendors           Vendor[]
  subscriptions     Subscription[]
  documents         Document[]
  wallet            Wallet?
  cards             VirtualCard[]
  transactions      Transaction[]
  importBatches     ImportBatch[]
  detected          DetectedSubscription[]
  requests          PurchaseRequest[]
  approvalRules     ApprovalRule[]
  renewalDecisions  RenewalDecision[]
  reminders         RenewalReminder[]
  cancellationTasks CancellationTask[]
  priceAlerts       PriceAlert[]
  codingRules       CodingRule[]
  accountingSyncs   AccountingSync[]
  toolAccess        ToolAccess[]
  checklists        AccessChecklist[]
  notifications     Notification[]
  emails            EmailLog[]
  integrations      Integration[]
  auditLogs         AuditLog[]
}

model Membership {
  id        String       @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role         @default(EMPLOYEE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([orgId, userId])
  @@index([userId])
}

model Team {
  id    String       @id @default(cuid())
  orgId String
  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name  String

  employees     Employee[]
  subscriptions Subscription[]
  requests      PurchaseRequest[]
  approvalRules ApprovalRule[]

  @@unique([orgId, name])
}

enum EmployeeStatus {
  ONBOARDING
  ACTIVE
  OFFBOARDING
  OFFBOARDED
}

/// A person in the organisation. Linked to a User when they can log in.
model Employee {
  id        String         @id @default(cuid())
  orgId     String
  org       Organisation   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  title     String?
  teamId    String?
  team      Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  status    EmployeeStatus @default(ACTIVE)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  ownedSubscriptions Subscription[]     @relation("SubscriptionOwner")
  requests           PurchaseRequest[]
  toolAccess         ToolAccess[]
  checklists         AccessChecklist[]
  cancellationTasks  CancellationTask[]
  approvalSteps      ApprovalRuleStep[]

  @@unique([orgId, email])
  @@index([orgId, teamId])
}

// ───────────────────────── Inventory ─────────────────────────

enum Category {
  COMMUNICATION
  DESIGN
  ENGINEERING
  PRODUCTIVITY
  SALES
  MARKETING
  FINANCE
  HR
  SECURITY
  INFRASTRUCTURE
  ANALYTICS
  SUPPORT
  LEGAL
  OTHER
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PENDING_CANCELLATION
  CANCELLED
  PAUSED
}

model Vendor {
  id        String       @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  website   String?
  /// Lower-cased merchant descriptor fragments used to match imported transactions.
  matchers  String[]     @default([])
  createdAt DateTime     @default(now())

  subscriptions Subscription[]
  transactions  Transaction[]
  codingRule    CodingRule?
  lockedCards   VirtualCard[]

  @@unique([orgId, name])
}

model Subscription {
  id           String             @id @default(cuid())
  orgId        String
  org          Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendorId     String
  vendor       Vendor             @relation(fields: [vendorId], references: [id])
  name         String
  plan         String
  cost         Decimal            @db.Decimal(12, 2)
  currency     String             @default("EUR")
  billingCycle BillingCycle
  renewalDate  DateTime
  ownerId      String?
  owner        Employee?          @relation("SubscriptionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  teamId       String?
  team         Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  category     Category
  status       SubscriptionStatus @default(ACTIVE)
  seats        Int?
  notes        String?
  startedAt    DateTime
  cancelledAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  documents         Document[]
  card              VirtualCard?
  transactions      Transaction[]
  requests          PurchaseRequest[]
  renewalDecisions  RenewalDecision[]
  reminders         RenewalReminder[]
  cancellationTasks CancellationTask[]
  priceAlerts       PriceAlert[]
  toolAccess        ToolAccess[]
  checklistItems    ChecklistItem[]
  detectedFrom      DetectedSubscription[]

  @@index([orgId, status])
  @@index([orgId, renewalDate])
  @@index([orgId, category])
}

enum DocumentKind {
  CONTRACT
  INVOICE
  QUOTE
  OTHER
}

model Document {
  id             String        @id @default(cuid())
  orgId          String
  org            Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  kind           DocumentKind  @default(OTHER)
  name           String
  mimeType       String
  sizeBytes      Int
  /// Storage key or data URL. The mock provider keeps small files inline.
  storageKey     String
  uploadedBy     String?
  createdAt      DateTime      @default(now())

  transaction Transaction?

  @@index([orgId, subscriptionId])
}

// ───────────────────────── Cards and money (mocked issuer) ─────────────────────────

model Wallet {
  id                  String       @id @default(cuid())
  orgId               String       @unique
  org                 Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  balance             Decimal      @db.Decimal(12, 2)
  currency            String       @default("EUR")
  lowBalanceThreshold Decimal      @db.Decimal(12, 2)
  updatedAt           DateTime     @updatedAt

  topUps WalletTopUp[]
}

model WalletTopUp {
  id        String   @id @default(cuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdBy String?
  createdAt DateTime @default(now())
}

enum LimitFrequency {
  PER_TRANSACTION
  MONTHLY
  ANNUAL
}

enum CardStatus {
  ACTIVE
  FROZEN
  CANCELLED
}

model VirtualCard {
  id             String         @id @default(cuid())
  orgId          String
  org            Organisation   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptionId String         @unique
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  /// Identifier at the card provider (mock: "mock_card_…").
  providerRef    String         @unique
  holderName     String
  last4          String
  expMonth       Int
  expYear        Int
  amountLimit    Decimal        @db.Decimal(12, 2)
  limitFrequency LimitFrequency
  vendorLock     Boolean        @default(true)
  lockedVendorId String?
  lockedVendor   Vendor?        @relation(fields: [lockedVendorId], references: [id], onDelete: SetNull)
  status         CardStatus     @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  transactions Transaction[]

  @@index([orgId, status])
}

enum TransactionStatus {
  PENDING
  SETTLED
  DECLINED
  REFUNDED
}

enum TransactionSource {
  CARD
  IMPORT
  MANUAL
}

model Transaction {
  id               String            @id @default(cuid())
  orgId            String
  org              Organisation      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptionId   String?
  subscription     Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  cardId           String?
  card             VirtualCard?      @relation(fields: [cardId], references: [id], onDelete: SetNull)
  vendorId         String?
  vendor           Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  amount           Decimal           @db.Decimal(12, 2)
  currency         String            @default("EUR")
  occurredAt       DateTime
  description      String
  status           TransactionStatus @default(SETTLED)
  source           TransactionSource @default(CARD)
  externalRef      String?
  // Accounting
  invoiceId        String?           @unique
  invoice          Document?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  codingAccount    String?
  codingTaxRate    Decimal?          @db.Decimal(5, 2)
  codingCostCentre String?
  codedAt          DateTime?
  syncedAt         DateTime?
  createdAt        DateTime          @default(now())

  priceAlert PriceAlert?

  @@index([orgId, occurredAt])
  @@index([orgId, subscriptionId])
}

enum ImportStatus {
  PROCESSING
  REVIEW
  DONE
}

model ImportBatch {
  id        String       @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fileName  String
  rowCount  Int
  status    ImportStatus @default(REVIEW)
  createdBy String?
  createdAt DateTime     @default(now())

  detected DetectedSubscription[]
}

enum DetectionStatus {
  PROPOSED
  CONFIRMED
  DISMISSED
}

model DetectedSubscription {
  id             String          @id @default(cuid())
  orgId          String
  org            Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  batchId        String
  batch          ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  vendorName     String
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("EUR")
  cadence        BillingCycle
  occurrences    Int
  lastSeenAt     DateTime
  confidence     Int
  status         DetectionStatus @default(PROPOSED)
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
}

// ───────────────────────── Requests and approvals ─────────────────────────

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model PurchaseRequest {
  id             String        @id @default(cuid())
  orgId          String
  org            Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requesterId    String
  requester      Employee      @relation(fields: [requesterId], references: [id])
  toolName       String
  vendorName     String
  plan           String
  cost           Decimal       @db.Decimal(12, 2)
  currency       String        @default("EUR")
  billingCycle   BillingCycle
  category       Category
  teamId         String?
  team           Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  reason         String
  startDate      DateTime
  status         RequestStatus @default(PENDING)
  /// Index of the approval step waiting on a decision.
  currentStep    Int           @default(0)
  ruleId         String?
  rule           ApprovalRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  decisions ApprovalDecision[]

  @@index([orgId, status])
}

model ApprovalRule {
  id        String       @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  /// Lower priority number wins when several rules match.
  priority  Int          @default(100)
  minAmount Decimal?     @db.Decimal(12, 2)
  maxAmount Decimal?     @db.Decimal(12, 2)
  teamId    String?
  team      Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  category  Category?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  steps    ApprovalRuleStep[]
  requests PurchaseRequest[]

  @@index([orgId, priority])
}

model ApprovalRuleStep {
  id         String       @id @default(cuid())
  ruleId     String
  rule       ApprovalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  order      Int
  /// Either anyone holding this role approves…
  role       Role?
  /// …or one named person does.
  approverId String?
  approver   Employee?    @relation(fields: [approverId], references: [id], onDelete: SetNull)

  @@unique([ruleId, order])
}

enum Decision {
  APPROVED
  REJECTED
}

model ApprovalDecision {
  id        String          @id @default(cuid())
  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  step      Int
  deciderId String
  decision  Decision
  comment   String?
  decidedAt DateTime        @default(now())

  @@index([requestId])
}

// ───────────────────────── Renewals ─────────────────────────

enum RenewalChoice {
  RENEW
  DOWNGRADE
  CANCEL
}

model RenewalDecision {
  id             String        @id @default(cuid())
  orgId          String
  org            Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  choice         RenewalChoice
  newPlan        String?
  newCost        Decimal?      @db.Decimal(12, 2)
  note           String?
  decidedBy      String
  decidedAt      DateTime      @default(now())

  @@index([orgId, subscriptionId])
}

model RenewalReminder {
  id             String       @id @default(cuid())
  orgId          String
  org            Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  daysBefore     Int
  dueAt          DateTime
  sentAt         DateTime?

  @@unique([subscriptionId, daysBefore, dueAt])
  @@index([orgId, dueAt])
}

enum TaskStatus {
  OPEN
  DONE
}

model CancellationTask {
  id             String       @id @default(cuid())
  orgId          String
  org            Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  assigneeId     String?
  assignee       Employee?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  status         TaskStatus   @default(OPEN)
  dueAt          DateTime
  note           String?
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  @@index([orgId, status])
}

model PriceAlert {
  id             String       @id @default(cuid())
  orgId          String
  org            Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  transactionId  String       @unique
  transaction    Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  previousAmount Decimal      @db.Decimal(12, 2)
  newAmount      Decimal      @db.Decimal(12, 2)
  acknowledgedAt DateTime?
  createdAt      DateTime     @default(now())

  @@index([orgId, acknowledgedAt])
}

// ───────────────────────── Accounting ─────────────────────────

model CodingRule {
  id         String       @id @default(cuid())
  orgId      String
  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vendorId   String       @unique
  vendor     Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  account    String
  taxRate    Decimal      @db.Decimal(5, 2)
  costCentre String
  updatedAt  DateTime     @updatedAt

  @@index([orgId])
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model AccountingSync {
  id            String       @id @default(cuid())
  orgId         String
  org           Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider      String
  status        SyncStatus
  exportedCount Int          @default(0)
  message       String?
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?

  @@index([orgId, startedAt])
}

// ───────────────────────── Access management ─────────────────────────

model ToolAccess {
  id             String       @id @default(cuid())
  orgId          String
  org            Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  grantedAt      DateTime     @default(now())
  lastActiveAt   DateTime?
  revokedAt      DateTime?

  @@unique([subscriptionId, employeeId])
  @@index([orgId, employeeId])
}

enum ChecklistKind {
  ONBOARDING
  OFFBOARDING
}

model AccessChecklist {
  id          String        @id @default(cuid())
  orgId       String
  org         Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind        ChecklistKind
  createdAt   DateTime      @default(now())
  completedAt DateTime?

  items ChecklistItem[]

  @@index([orgId, employeeId])
}

enum ChecklistAction {
  GRANT
  REVOKE
}

model ChecklistItem {
  id             String          @id @default(cuid())
  checklistId    String
  checklist      AccessChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  action         ChecklistAction
  done           Boolean         @default(false)
  doneAt         DateTime?
  doneBy         String?

  @@unique([checklistId, subscriptionId])
}

// ───────────────────────── Notifications, integrations, audit ─────────────────────────

model Notification {
  id        String       @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([userId, readAt])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// Outbound email, written by the mock mailer so the demo can show what would have been sent.
model EmailLog {
  id        String       @id @default(cuid())
  orgId     String
  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  to        String
  subject   String
  body      String
  status    EmailStatus  @default(SENT)
  createdAt DateTime     @default(now())

  @@index([orgId, createdAt])
}

enum IntegrationKind {
  CARD_ISSUER
  ACCOUNTING
  SSO
  EMAIL
}

model Integration {
  id        String          @id @default(cuid())
  orgId     String
  org       Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind      IntegrationKind
  provider  String
  enabled   Boolean         @default(true)
  config    Json?
  updatedAt DateTime        @updatedAt

  @@unique([orgId, kind])
}

model AuditLog {
  id         String       @id @default(cuid())
  orgId      String
  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  /// Dotted verb, e.g. "member.role_changed", "card.frozen", "request.approved".
  action     String
  entityType String
  entityId   String?
  summary    String
  before     Json?
  after      Json?
  createdAt  DateTime     @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, entityType, entityId])
}
