# Photo keys. Copy this file to .env.local and fill in one of them; .env.local is git-ignored and only read
# by scripts/fetch-photos.mjs on your machine. If both are set, Unsplash is used.
# Unsplash: https://unsplash.com/oauth/applications (the "Access Key")
UNSPLASH_ACCESS_KEY=
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=
